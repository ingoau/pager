# Postgres connection string. The schema is created by `bun run db:migrate`.
#
# Add ?sslmode=verify-full in production so the database certificate is actually
# verified. Without an explicit sslmode, a remote host still gets TLS but the
# certificate is NOT checked, which does not stop an attacker who can intercept
# the connection.
DATABASE_URL="postgres://user:password@host:5432/pager?sslmode=verify-full"

# Long random string used to sign sessions and WebAuthn challenges.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin the app is served from, with no trailing slash.
# Passkeys are bound to this hostname, so changing it invalidates existing ones.
BETTER_AUTH_URL="http://localhost:5173"

# PagerDuty REST API key (Integrations -> API Access Keys).
PAGERDUTY_KEY=""

# ID of the PagerDuty service incidents are created on.
PAGERDUTY_SERVICE=""

# Login email of a user in your PagerDuty account. The REST API requires this
# in the `From` header and rejects the request outright without it.
PAGERDUTY_FROM=""
